# PostgreSQL local o administrado (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://usuario:contrasena@host:5432/julia?sslmode=require

# Docker Compose: contraseña de PostgreSQL (usa un valor hexadecimal).
# Compose construye DATABASE_URL con el host interno db y esta contraseña.
POSTGRES_PASSWORD=
AUTH_URL=http://localhost:3000

# Clave privada compartida entre Next.js y FastAPI: openssl rand -hex 32
BACKEND_API_KEY=
# Solo para Next.js fuera de Docker; Compose usa http://backend:8000.
# BACKEND_URL=http://localhost:8000

# Contraseña única para entrar a /panel
PANEL_PASSWORD=cambia-esta-clave

# Auth.js: login de clientes con Google
AUTH_SECRET=genera-uno-con-npx-auth-secret
AUTH_GOOGLE_ID=tu-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=tu-client-secret
